{
  "name": "yuna-knowledge-base",
  "version": "1.0.0",
  "description": "YUNA Knowledge Base",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vitepress dev vitepress-docs",
    "dev:full": "node scripts/dev-full.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:workers": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir .wrangler/check-views && wrangler deploy --dry-run --config worker-ranking/wrangler.toml --outdir .wrangler/check-ranking",
    "test": "node --no-warnings --test scripts/test-*.mjs",
    "test:feedback": "node --no-warnings scripts/test-feedback-api.mjs",
    "test:local": "node scripts/dev-full.mjs --smoke",
    "db:migrate:local": "node scripts/migrate-d1.mjs --local --persist-to .wrangler/state",
    "db:migrate:remote": "node scripts/migrate-d1.mjs --remote",
    "prebuild": "npm run check:docs",
    "build": "vitepress build vitepress-docs",
    "postbuild": "npm run check:site && npm run check:search",
    "verify": "npm test && npm run build && node worker-ranking/gen-titles.mjs && npm run check:workers && npm run test:local",
    "preview": "vitepress preview vitepress-docs"
  },
  "devDependencies": {
    "@nolebase/markdown-it-bi-directional-links": "^2.18.2",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@nolebase/vitepress-plugin-inline-link-preview": "^2.18.2",
    "@vue/compiler-sfc": "3.5.18",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.0",
    "minisearch": "^7.2.0",
    "parse5": "^7.3.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "mermaid": "^10.0.0"
  }
}
